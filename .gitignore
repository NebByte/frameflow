*.egg-info/
build/
dist/

# Rendered output from personal footage. Kept out of the repo deliberately;
# samples/ carries a synthetic finished job instead. This was stripped from
# history once, then re-added by a `git add -A` because the path was still
# tracked -- an ignore rule does nothing for a tracked file.
demos/

