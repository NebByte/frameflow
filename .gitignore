# Generated ground truth for validate.py. Regenerate with:
#     python tools/make_test_clip.py
# The panorama is 3MB and derivable in seconds, so it does not belong in git;
# the clips cut from it do, because the demo and the tests need them.
media/pano_flat.png

# Personal source footage. Synthetic clips are enough to run everything.
media/gym_pan.mp4

# build artefacts
*.egg-info/
build/
dist/

# Rendered output from personal footage. Kept out of the repo deliberately;
# samples/ carries a synthetic finished job instead. This was stripped from
# history once, then re-added by a `git add -A` because the path was still
# tracked -- an ignore rule does nothing for a tracked file.
demos/

# Wikimedia's Drone_flight_over_park.webm, CC BY-SA 4.0. Share-alike content
# does not belong in an Apache-2.0 repository, and redistributing it without
# attribution is a violation regardless. Fetch it yourself if you want it:
#   https://commons.wikimedia.org/wiki/File:Drone_flight_over_park.webm
media/drone.mp4

# The Devpost draft. It carries the entrant email and reads as scaffolding
# ("copy from here", "link to add") rather than as part of the product.
docs/SUBMISSION.md

# clickhousectl writes an admin API secret here, inside the project dir.
.clickhouse/

